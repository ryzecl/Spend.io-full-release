{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/(auth)/sign-up.jsx",
    "app/(auth)/sign-in.jsx",
    "app/(auth)/_layout.jsx",
    "app/(root)/_layout.jsx",
    "app/(root)/index.jsx",
    "app/_layout.jsx",
    "components/SignOutButton.jsx",
    "components/SafeScreen.jsx"
  ]
}
